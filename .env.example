# OpenAI is opt-in. When false or omitted, the application uses curated content
# and does not create OpenAI API requests.
OPENAI_INSIGHTS_ENABLED=true

# Provider: "openai" or "azure". When omitted, Azure AI Foundry is used if
# AZURE_OPENAI_ENDPOINT is set, otherwise OpenAI.
OPENAI_PROVIDER=

# OpenAI (API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Azure AI Foundry (Microsoft Entra ID, no API key). Signs in with
# DefaultAzureCredential: the Windows account broker on Windows, then a service
# principal (AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET), managed
# identity, Azure CLI, Azure PowerShell, azd or VS Code.
# The endpoint is the resource URL; /openai/v1/ is appended automatically.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_SCOPE=https://ai.azure.com/.default
# Set to false to skip the Windows account broker (e.g. in containers).
AZURE_USE_BROKER=

# Jira server configuration. JIRA_PAT may be omitted locally when
# access-token.txt is present at the project root.
JIRA_BASE_URL=https://proactionnppoc.ent.cgi.com/jira
JIRA_PROJECT_KEY=DASH
JIRA_BOARD_ID=4174
JIRA_PAT=
